("Mechanical Engineer" OR "Project Engineer" OR "Application Engineer" OR "Field Service") AND (Automotive OR Manufacturing OR Equipment) AND (Chinese OR Mandarin) AND ("Visa Sponsorship" OR "Work Permit" OR "Relocation" OR "Blue Card")

# 策略B：测试/验证/现场支持方向（发挥DV经验，避开设计内卷）
("Test Engineer" OR "Validation Engineer" OR "Field Service Engineer" OR "FAE" OR "Testingenieur" OR "Servicetechniker" OR "Ingegnere di Collaudo") AND (Mechanical OR Automotive OR Equipment)
